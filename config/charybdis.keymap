#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-input-processor.dtsi>
#include <behaviors/runtime_macro.dtsi>

&lt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/* Indices are POSITIONAL:
 *   0 QWERTY  1 F_layers  2 BT_layers  3 scroll_gate
 *   4..7 extra1..extra4 -> reserved, fill in DYA Studio
 *
 * scroll_gate must stay at index 3: scroll_rip in charybdis_right.overlay
 * gates on bit 3 (<16>). Snipe needs no layer -- &rip_ldpi is the hotkey.
 * Studio cannot add layers beyond the declared count, so the number is fixed
 * at flash time; only the contents can be deferred. */
#define SCROLL_L  3
#define USER_1_L  4
#define USER_2_L  5
#define USER_3_L  6
#define USER_4_L  7

&sl {
    release-after-ms = <60000>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            display-name = "QWERTY";
            bindings = <
&kp ESC         &kp N1  &kp N2   &kp N3            &kp N4        &kp N5          &kp N6      &kp N7     &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB         &kp Q   &kp W    &kp E             &kp R         &kp T           &kp Y       &kp U      &kp I      &kp O    &kp P     &kp BSLH
&kp CAPSLOCK    &kp A   &kp S    &kp D             &kp F         &kp G           &kp H       &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z   &kp X    &kp C             &kp V         &kp B           &kp N       &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                 &kp LEFT_CONTROL  &kp SPACE     &kp LEFT_WIN    &kp DELETE  &kp BACKSPACE
                                                   &mo 1         &kp LEFT_ALT    &kp ENTER
            >;
        };

        F_layers {
            display-name = "FN";
            bindings = <
&kp F1     &kp F2 &kp F3    &kp F4 &kp F5       &kp F6      &kp F7  &kp F8    &kp F9       &kp F10    &kp F11    &kp F12
&kp GRAVE  &none  &none     &none  &none        &none       &none   &none     &kp UP_ARROW &none      &kp LBKT   &kp RBKT
&trans     &none  &none     &none  &none        &none       &none   &kp LEFT  &kp DOWN     &kp RIGHT  &kp EQUAL  &none
&trans     &none  &rip_ldpi &none  &mo SCROLL_L &mo 2       &none   &mkp LCLK &mkp RCLK    &none      &none      &kp K_APP
                            &trans &trans       &trans      &trans  &trans
                                   &trans       &trans      &trans
            >;
        };

        BT_layers {
            display-name = "BT";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR    &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &studio_unlock
&trans  &trans        &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
                                    &trans        &trans        &trans          &trans      &trans
                                                  &trans        &trans          &trans
            >;
        };

        scroll_gate {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        extra1 { status = "reserved"; display-name = "User 1"; };
        extra2 { status = "reserved"; display-name = "User 2"; };
        extra3 { status = "reserved"; display-name = "User 3"; };
        extra4 { status = "reserved"; display-name = "User 4"; };
    };
};
